rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. USERS COLLECTION: Only authenticated document owner can read and write
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 2. HOSPITALS COLLECTION: Public read access for hospital discovery; read-only from client
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // 3. DEFAULT DENY: Block all unmapped collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
